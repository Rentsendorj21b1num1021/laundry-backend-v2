meta {
  name: list
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/bo-api/user/list
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "page": 1,
    "limit": 10,
    "filter": {
      "username": "",
      "phone": "",
      "email": ""
    }
  }
}

script:post-response {
  {
   
  }
}
