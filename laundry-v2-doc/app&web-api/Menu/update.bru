meta {
  name: update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/menus/MENU_ID_HERE
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "isActive": true,
    "categories": [
      {
        "id": "cat1",
        "category": "Хувцас угаалт",
        "items": [
          {
            "id": "item1",
            "name": "Цамц",
            "price": 6000,
            "parentId": "cat1"
          }
        ]
      }
    ]
  }
}

docs {
  Only `service`, `categories`, `isActive` fields are accepted — this replaces the whole
  categories/items tree, so prefer the granular category/item endpoints for a single
  add/edit/delete operation.
}
