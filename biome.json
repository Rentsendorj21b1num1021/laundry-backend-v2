{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": false, "includes": ["**", "!node_modules", "!lib", "!dist", "!migrate", "!scripts"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 200 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" },
      "style": { "useConst": "error", "useTemplate": "error", "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "off" }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              [":PACKAGE:", "!@mezorn-com/**"],
              ":BLANK_LINE:",
              "@mezorn-com/**",
              ":BLANK_LINE:",
              [":ALIAS:", "!@/data/**", "!@/handlers/**", "!@/misc/**", "!@/services/**"],
              ":BLANK_LINE:",
              "@/data/**",
              ":BLANK_LINE:",
              "@/handlers/**",
              ":BLANK_LINE:",
              "@/misc/**",
              ":BLANK_LINE:",
              "@/services/**",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "none", "semicolons": "asNeeded" } }
}
